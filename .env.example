# ---- App ----
NODE_ENV=production
PORT=3000
# Long random string (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
# true = show one-click demo logins on the sign-in page (never in production)
DEMO_MODE=false
# Apply pending database migrations automatically when the server starts
AUTO_MIGRATE=true
# Behind nginx / a load balancer on another host, set the number of proxy hops (e.g. 1)
TRUST_PROXY=loopback

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=hms_app
DB_PASSWORD=your_strong_db_password
DB_NAME=hospital_mgs
